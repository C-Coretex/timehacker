# Copy this file to `.env` (which is git-ignored) and fill in real values.
# Used by docker-compose.yml.

# --- Which slice of the stack `docker compose up` starts, when no --profile is passed ---
# minimal = ui + api + db | dev = + pgAdmin | full = + observability
COMPOSE_PROFILES=dev

# --- Database ---
# One PostgreSQL instance hosts both the TimeHacker and TimeHackerIdentity databases.
POSTGRES_PASSWORD=example

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=example@example.com
PGADMIN_DEFAULT_PASSWORD=example

# --- Observability (Grafana LGTM stack) ---
# Grafana UI login (http://localhost:3000).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=example

# --- API connection strings (composed from the DB passwords above) ---
# Hosts match the docker-compose service names.
ConnectionStrings__TimeHackerConnectionString=Host=timehacker.infrastructure;Database=TimeHacker;Port=5432;Username=postgres;Password=example;Include Error Detail=true
ConnectionStrings__IdentityConnectionString=Host=timehacker.infrastructure;Database=TimeHackerIdentity;Port=5432;Username=postgres;Password=example;Include Error Detail=true

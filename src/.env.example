# Copy this file to `.env` (which is git-ignored) and fill in real values.
# Used by docker-compose.yml.

# --- Main database ---
POSTGRES_PASSWORD=example

# --- Identity database ---
IDENTITY_POSTGRES_PASSWORD=example

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=example@example.com
PGADMIN_DEFAULT_PASSWORD=example

# --- API connection strings (composed from the DB passwords above) ---
# Hosts match the docker-compose service names.
ConnectionStrings__TimeHackerConnectionString=Host=timehacker.infrastructure;Database=TimeHacker;Port=5432;Username=postgres;Password=example;Include Error Detail=true
ConnectionStrings__IdentityConnectionString=Host=timehacker.infrastructure.identity;Database=TimeHackerIdentity;Port=5432;Username=postgres;Password=example;Include Error Detail=true
